# GlobalCart Backend Production Environment Configuration
NODE_ENV=production
PORT=4000

# CockroachDB Connection String (from CockroachDB Cloud console)
DATABASE_URL="postgresql://<user>:<password>@<cluster-host>:26257/defaultdb?sslmode=verify-full"

# 256-bit Secret Key for Signing Authentication JWTs
JWT_SECRET="replace-with-a-secure-random-64-character-string"

# Comma-separated list of allowed frontend origins (no trailing slash)
# Add your production Vercel URL and any custom domains
CORS_ORIGINS="https://your-globalcart-frontend.vercel.app"
